        "editorMode": "code", "format": "table", "rawQuery": true,
        "rawSql": "SELECT COUNT(DISTINCT id) AS new_users FROM \"user\" as u WHERE u.created_at BETWEEN $__timeFrom() AND $__timeTo();",
        "refId": "A"
