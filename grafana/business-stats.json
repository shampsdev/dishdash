        "editorMode": "code", "format": "table", "rawQuery": true,
        "rawSql": "SELECT DATE_TRUNC('hour', \"created_at\") AS day, COUNT(*) AS user_count FROM \"user\" GROUP BY DATE_TRUNC('hour', \"created_at\") ORDER BY day;",
        "refId": "A"
